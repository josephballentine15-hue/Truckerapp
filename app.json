{
  "expo": {
    "name": "LogIt",
    "slug": "logit",
    "version": "1.0.0",
    "scheme": "logit",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a2332",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Trucker Log needs access to your photos so you can attach receipts, BOLs, and load photos to your logbook.",
          "cameraPermission": "Trucker Log needs access to your camera so you can snap a photo of receipts, BOLs, and loads for your logbook."
        }
      ]
    ]
  }
}
